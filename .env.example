# Copiá este archivo a ".env" (sin ".example") en la raíz del repo y llená
# SOLO UNO de los dos bloques de abajo. ".env" está en .gitignore — nunca
# se sube al repo, se llena a mano en cada máquina que necesite mandar
# notificaciones de Discord (normalmente solo la de Diego).
#
# scripts/common.py lo carga automáticamente — no hace falta exportar
# nada en tu shell ni reiniciar la terminal, solo guardar el archivo.

# ---- Camino A: Webhook (notifica a un canal) ----
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/AQUI-TU-URL

# ---- Camino B: Bot + DM (notifica a cada persona en privado) ----
# También requiere llenar discord_map.yaml con el Discord user ID real
# de cada compañero.
# DISCORD_BOT_TOKEN=AQUI-TU-TOKEN
